# SuperDash Environment Configuration Template
# Copy this file to .env.local for local customizations

# Base URL path for web deployment (e.g., /SuperDash/ for GitHub Pages subpath, or ./ for relative)
VITE_BASE_PATH=./

# Application Release Channel
VITE_APP_CHANNEL=stable

# Optional Custom Update Feed Endpoint (defaults to relative ./updates/latest.json)
# VITE_UPDATE_URL=https://raw.githubusercontent.com/omran/SuperDash/main/public/updates/latest.json
